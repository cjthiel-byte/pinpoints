---
import Layout from '../layouts/Layout.astro';
import AuthPanel from '../components/AuthPanel';
import Globe from '../components/Globe';
---

<Layout title="Pinpoints">
	<main class="relative h-screen w-screen overflow-hidden">
		<Globe client:only="react" />
		<div class="pointer-events-none absolute inset-0 flex flex-col items-start justify-start p-3 sm:p-6">
			<h1 class="pointer-events-none flex items-center gap-1.5 text-lg font-semibold tracking-tight drop-shadow-lg sm:gap-2 sm:text-2xl">
				<svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0 text-blue-400 sm:h-5 sm:w-5">
					<path
						d="M12 2C7.58 2 4 5.58 4 10c0 5.25 6.5 11.5 7.03 12.01a1.4 1.4 0 0 0 1.94 0C13.5 21.5 20 15.25 20 10c0-4.42-3.58-8-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"
					></path>
				</svg>
				Pinpoints
			</h1>
			<div
				class="pointer-events-auto absolute right-3 top-3 rounded-xl border border-white/10 bg-slate-950/80 p-3 shadow-2xl shadow-black/50 backdrop-blur-md sm:right-6 sm:top-6 sm:p-4"
			>
				<AuthPanel client:load />
			</div>
		</div>
	</main>
</Layout>
